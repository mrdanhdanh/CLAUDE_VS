@page "/"
@rendermode InteractiveServer
@inject IKanaService KanaService
@inject IKanjiService KanjiService
@inject IVocabService VocabService
@inject IGrammarService GrammarService
@inject IProgressService Progress
@inject IJSRuntime JS

<PageTitle>N5 Blazor — Học JLPT N5</PageTitle>

<PageHelper Title="Trang chủ / Dashboard"
            Purpose="Tổng quan lộ trình N5, thống kê tiến độ, điều hướng nhanh tới 6 khu vực học. Là entry point cho người mới — thấy ngay mình đang ở đâu và nên học gì tiếp."
            Structure="Route '/' → Home.razor. Gồm Hero (glass + rainbow), 4 stat cards, roadmap 5 bước, quick actions, tips. Dùng MainLayout (sidebar + topbar)."
            Techniques="Blazor Server (InteractiveServer), DI inject 5 services, IProgressService (Scoped) load từ localStorage qua JS interop (n5Storage), OnAfterRenderAsync firstRender pattern, ProgressRing component, RainbowCard wrapper."
            Features="Hiển thị % hoàn thành Kana/Kanji/Vocab/Grammar, streak, nút CTA tới từng trang, roadmap trực quan, responsive grid."
            Route="/"
            ComponentName="Home.razor"
            TechBullets="@(new[]{"@rendermode InteractiveServer — interactivity sau SSR","@inject IKanaService/IKanjiService/... — DI Singleton","IJSRuntime + n5Storage.get/set — localStorage","OnAfterRenderAsync(firstRender) — tránh prerender JS lỗi"})"
            FeatureBullets="@(new[]{"4 stat cards với ProgressRing","Roadmap 5 bước (Kana→Kanji→Vocab→Grammar→Test)","Quick actions 6 nút tới từng trang","Streak + % tổng hợp từ ProgressService"})" />

<div class="rainbow-wrap" style="margin-bottom:16px">
    <div class="glass hero">
        <div class="hero-orb" aria-hidden="true"></div>
        <div style="position:relative">
            <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(99,102,241,0.12);border:1px solid rgba(99,102,241,0.25);padding:6px 12px;border-radius:9999px;font-size:12px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#a5b4fc;margin-bottom:12px">
                ✨ JLPT N5 • Cho người mới bắt đầu • Blazor Server
            </div>
            <h1>Học <span>JLPT N5</span> từ số 0<br/>với Liquid Glass</h1>
            <p>
                Lộ trình 5 bước: <strong>Kana</strong> → <strong>Kanji</strong> → <strong>Từ vựng</strong> → <strong>Ngữ pháp</strong> → <strong>Thi thử</strong>.
                Mỗi trang đều có <strong>Helper</strong> giải thích rõ mục đích, cấu trúc, kỹ thuật Blazor và tính năng — vừa học tiếng Nhật, vừa học Blazor.
            </p>
            <div class="hero-actions">
                <a class="btn btn-primary" href="/kana">Bắt đầu với Kana →</a>
                <a class="btn btn-glass" href="/practice">🧪 Thi thử ngay</a>
                <a class="btn btn-glass" href="/progress">📊 Xem tiến độ</a>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:14px">
                <span class="badge badge-primary">Blazor Server</span>
                <span class="badge">DI • Services</span>
                <span class="badge">JS Interop</span>
                <span class="badge">EditForm</span>
                <span class="badge">localStorage</span>
            </div>
        </div>
    </div>
</div>

<div class="grid grid-4" style="margin-bottom:16px">
    <div class="rainbow-wrap">
        <div class="glass stat">
            <div class="stat-label">Kana</div>
            <div style="display:flex;align-items:center;gap:12px">
                <ProgressRing Value="@KanaPercent" Label="Kana" Size="72" />
                <div>
                    <div class="stat-value">@Progress.Progress.LearnedKana.Count / 92</div>
                    <div class="stat-sub">Hiragana + Katakana</div>
                </div>
            </div>
        </div>
    </div>
    <div class="glass stat">
        <div class="stat-label">Kanji N5</div>
        <div style="display:flex;align-items:center;gap:12px">
            <ProgressRing Value="@KanjiPercent" Label="Kanji" Size="72" />
            <div>
                <div class="stat-value">@Progress.Progress.LearnedKanji.Count / @TotalKanji</div>
                <div class="stat-sub">36 kanji mẫu</div>
            </div>
        </div>
    </div>
    <div class="glass stat">
        <div class="stat-label">Từ vựng</div>
        <div style="display:flex;align-items:center;gap:12px">
            <ProgressRing Value="@VocabPercent" Label="Vocab" Size="72" />
            <div>
                <div class="stat-value">@Progress.Progress.LearnedVocabIds.Count / @TotalVocab</div>
                <div class="stat-sub">40 từ mẫu</div>
            </div>
        </div>
    </div>
    <div class="glass stat">
        <div class="stat-label">Ngữ pháp</div>
        <div style="display:flex;align-items:center;gap:12px">
            <ProgressRing Value="@GrammarPercent" Label="Grammar" Size="72" />
            <div>
                <div class="stat-value">@Progress.Progress.LearnedGrammarIds.Count / @TotalGrammar</div>
                <div class="stat-sub">15 mẫu</div>
            </div>
        </div>
    </div>
</div>

<div class="grid grid-2" style="margin-bottom:16px">
    <div class="glass card">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
            <h3 style="margin:0;font-size:15px;font-weight:800">🗺️ Lộ trình 5 bước</h3>
            <span class="badge">Gợi ý cho người mới</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px">
            @foreach (var step in Roadmap)
            {
                <a href="@step.Href" style="display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:12px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.06);text-decoration:none;color:inherit;transition:transform 150ms">
                    <span style="width:36px;height:36px;border-radius:10px;display:grid;place-items:center;background:linear-gradient(135deg, var(--primary), var(--secondary));color:white;font-weight:700;flex-shrink:0">@step.Num</span>
                    <div style="flex:1">
                        <div style="font-weight:700;font-size:14px">@step.Title</div>
                        <div style="font-size:12px;color:var(--text-muted)">@step.Desc</div>
                    </div>
                    <span style="color:var(--text-dim)">→</span>
                </a>
            }
        </div>
    </div>
    <div class="glass card">
        <h3 style="margin:0 0 12px;font-size:15px;font-weight:800">⚡ Hành động nhanh</h3>
        <div class="grid grid-2">
            <a class="glass" style="padding:14px;border-radius:14px;text-decoration:none;color:inherit;display:flex;flex-direction:column;gap:6px" href="/kana">
                <span style="font-size:20px">あ</span><strong style="font-size:14px">Học Kana</strong><span style="font-size:12px;color:var(--text-muted)">46 Hiragana + 46 Katakana</span>
            </a>
            <a class="glass" style="padding:14px;border-radius:14px;text-decoration:none;color:inherit;display:flex;flex-direction:column;gap:6px" href="/kanji">
                <span style="font-size:20px">漢</span><strong style="font-size:14px">Học Kanji</strong><span style="font-size:12px;color:var(--text-muted)">36 kanji N5 mẫu</span>
            </a>
            <a class="glass" style="padding:14px;border-radius:14px;text-decoration:none;color:inherit;display:flex;flex-direction:column;gap:6px" href="/vocab">
                <span style="font-size:20px">📚</span><strong style="font-size:14px">Từ vựng</strong><span style="font-size:12px;color:var(--text-muted)">Flashcard + search</span>
            </a>
            <a class="glass" style="padding:14px;border-radius:14px;text-decoration:none;color:inherit;display:flex;flex-direction:column;gap:6px" href="/grammar">
                <span style="font-size:20px">📝</span><strong style="font-size:14px">Ngữ pháp</strong><span style="font-size:12px;color:var(--text-muted)">15 mẫu N5</span>
            </a>
            <a class="glass" style="padding:14px;border-radius:14px;text-decoration:none;color:inherit;display:flex;flex-direction:column;gap:6px" href="/practice">
                <span style="font-size:20px">🧪</span><strong style="font-size:14px">Thi thử</strong><span style="font-size:12px;color:var(--text-muted)">20 câu • chấm điểm</span>
            </a>
            <a class="glass" style="padding:14px;border-radius:14px;text-decoration:none;color:inherit;display:flex;flex-direction:column;gap:6px" href="/progress">
                <span style="font-size:20px">📊</span><strong style="font-size:14px">Tiến độ</strong><span style="font-size:12px;color:var(--text-muted)">Streak @Progress.Progress.StreakDays ngày</span>
            </a>
        </div>
        <div style="margin-top:12px;padding:10px 12px;border-radius:12px;background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.18);font-size:12px;color:#fcd34d">
            💡 <strong>Mẹo:</strong> Mỗi trang đều có <strong>Helper</strong> ở đầu — bấm để xem trang dùng làm gì, cấu trúc, kỹ thuật Blazor và tính năng.
        </div>
    </div>
</div>

<div class="glass card">
    <h3 style="margin:0 0 8px;font-size:15px;font-weight:800">🧠 Blazor được dùng ở đâu?</h3>
    <div class="grid grid-3">
        <div style="padding:12px;border-radius:12px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.06)">
            <div style="font-weight:700;font-size:13px;margin-bottom:4px">🔌 DI &amp; Services</div>
            <div style="font-size:12px;color:var(--text-muted)">6 services Singleton/Scoped inject vào mọi trang. Single source of truth cho dữ liệu N5.</div>
            <code style="font-size:11px">builder.Services.AddSingleton&lt;IKanjiService&gt;</code>
        </div>
        <div style="padding:12px;border-radius:12px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.06)">
            <div style="font-weight:700;font-size:13px;margin-bottom:4px">🔄 Interactivity</div>
            <div style="font-size:12px;color:var(--text-muted)">Server interactivity + streaming. StateHasChanged, EventCallback, bind, onclick.</div>
            <code style="font-size:11px">rendermode InteractiveServer</code>
        </div>
        <div style="padding:12px;border-radius:12px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.06)">
            <div style="font-weight:700;font-size:13px;margin-bottom:4px">📝 Forms &amp; JS</div>
            <div style="font-size:12px;color:var(--text-muted)">EditForm + DataAnnotationsValidator cho quiz, JS interop cho localStorage &amp; speech.</div>
            <code style="font-size:11px">IJSRuntime.InvokeAsync</code>
        </div>
    </div>
</div>

@code {
    private int TotalKanji => KanjiService.GetAll().Count;
    private int TotalVocab => VocabService.GetAll().Count;
    private int TotalGrammar => GrammarService.GetAll().Count;
    private int KanaPercent => (int)Math.Round(Progress.Progress.LearnedKana.Count * 100.0 / 92);
    private int KanjiPercent => TotalKanji==0?0:(int)Math.Round(Progress.Progress.LearnedKanji.Count*100.0/TotalKanji);
    private int VocabPercent => TotalVocab==0?0:(int)Math.Round(Progress.Progress.LearnedVocabIds.Count*100.0/TotalVocab);
    private int GrammarPercent => TotalGrammar==0?0:(int)Math.Round(Progress.Progress.LearnedGrammarIds.Count*100.0/TotalGrammar);

    private record Step(int Num, string Title, string Desc, string Href);
    private List<Step> Roadmap = new()
    {
        new(1,"Kana — Bảng chữ cái","Hiragana + Katakana, 46 chữ mỗi bảng","/kana"),
        new(2,"Kanji — Hán tự","36 kanji N5 theo bài, có ví dụ","/kanji"),
        new(3,"Từ vựng — Vocabulary","40 từ theo chủ đề, flashcard","/vocab"),
        new(4,"Ngữ pháp — Grammar","15 mẫu câu N5, ví dụ + bài tập","/grammar"),
        new(5,"Thi thử — Practice","20 câu trắc nghiệm, chấm điểm","/practice"),
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Progress.LoadAsync();
            Progress.OnChange += StateHasChanged;
            StateHasChanged();
        }
    }
}
