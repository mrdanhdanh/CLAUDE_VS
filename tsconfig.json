{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["playwright.config.ts", "tests/**/*.ts", "scripts/**/*.ts", ".agent/scripts/**/*.mjs", ".github/harness/scripts/**/*.mjs"]
}
