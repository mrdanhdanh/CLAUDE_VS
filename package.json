{
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "mutation": "node scripts/mutation.mjs",
    "slop:scan": "node scripts/slop-check.mjs --scan",
    "audit:verify": "node .agent/scripts/audit.mjs verify",
    "policy:check": "node .agent/scripts/policy-check.mjs --check",
    "cosmos:refresh": "node .github/harness/scripts/entangle.mjs --graph --out www/cosmos/graph.json && node .github/harness/scripts/cosmic-scale.mjs --json --out www/cosmos/scale.json && node .github/harness/scripts/auto-learn.mjs watchdog --json --out www/cosmos/hawking.json && node .github/harness/scripts/generate-status.mjs",
    "hawking": "node .github/harness/scripts/auto-learn.mjs watchdog",
    "cosmos:check": "node .github/harness/scripts/cosmic-scale.mjs --budget 10",
    "cosmos:gate": "node .github/harness/scripts/cosmic-scale.mjs --trend 3 --budget 10",
    "entangle": "node .github/harness/scripts/entangle.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3"
  }
}
