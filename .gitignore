# ===== Library RAG — Local only, NEVER commit documents =====
# Source documents (PDF/DOCX/TXT/MD) — local, avoid leakage
books/
# Exported chunks (registry + full text) — local, gitignored
www/library/export.json
www/library/library-export-*.json
www/library/export.full.json

# ===== .NET / Blazor build artifacts — NEVER commit (debug) =====
bin/
obj/
publish/
out/
TestResults/
*.coverage
*.coveragexml
*.user
*.suo
.vs/
*.dbmdl
*.jfm

# ===== Governance — audit + credentials (never commit) =====
.agent/audit.jsonl
.agent/credentials.enc.json
.agent/credentials.key
.agent/credentials.key.bak
.agent/audit.key
.agent/traces/
# ===== Memory — working/short ephemeral (local only) =====
.agent/memory/working.jsonl
.agent/memory/short.jsonl
# ===== Workflows — run checkpoints (local only) =====
.agent/runs/
# ===== CUA — evidence (local only) =====
.agent/cua/

# ===== Reef-lite — ephemeral records/reports (local only) =====
.agent/records/
.agent/reports.jsonl
.agent/attestations.jsonl
.agent/mutation-report.json
# .agent/versions/ is kept (version history) — do not ignore

# ===== Common =====
node_modules/
.DS_Store
*.log
dist/
build/

# ===== Exported skills — skip demo binaries (mp3/jpg/png), keep code =====
.claude/skills/*/assets/
*.mp3
